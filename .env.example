NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Required for admin changes to other users' passwords. Keep this server-only.
# A legacy SUPABASE_SERVICE_ROLE_KEY can be used instead.
SUPABASE_SECRET_KEY=

# Required for Download Backup. Server-only; never use NEXT_PUBLIC_ or commit it.
# Supabase Connect > Session pooler, port 5432. See docs/database-backups.md.
# Create the backup reader there, then URL-encode its password in this connection.
SUPABASE_DB_URL=postgresql://backup_reader.your-project-ref:your-encoded-backup-password@aws-0-your-region.pooler.supabase.com:5432/postgres
